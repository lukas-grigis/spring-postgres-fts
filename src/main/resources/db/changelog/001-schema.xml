<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="001-extensions" author="spring-postgres-fts">
        <comment>pg_trgm powers the FUZZY retriever: similarity() and the % operator.</comment>
        <sql>
            CREATE
            EXTENSION IF NOT EXISTS pg_trgm
        </sql>
    </changeSet>

    <changeSet id="002-genre-table" author="spring-postgres-fts">
        <createTable tableName="genre">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="TEXT">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="003-author-table" author="spring-postgres-fts">
        <createTable tableName="author">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="TEXT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!--
        GIN over GiST for the trigram index: a gin_trgm_ops index can answer the % operator (and
        LIKE/ILIKE) from trigrams, and it cannot answer a bare `similarity() >= 0.2` comparison.
        That asymmetry is exactly why the FUZZY predicate in BookSearchExpressions.matches uses the
        operator and only the ranking calls similarity().

        Being precise about the plan: "usable by" is not "used by". At 33 authors the planner takes
        a sequential scan regardless, and FUZZY's real predicate ORs across book and author, which
        no single-table index can answer at any size (see changeset 007). Run EXPLAIN before
        believing any index in this file is doing work on a corpus this small.

        GiST would additionally buy `ORDER BY name <-> :q` closest-first scans, which this demo
        does not need.
    -->
    <changeSet id="004-author-name-trgm-index" author="spring-postgres-fts">
        <comment>GIN trigram index on author.name: usable by the % operator, not by similarity() >=.</comment>
        <sql>CREATE INDEX idx_author_name_trgm ON author USING GIN (NAME gin_trgm_ops);</sql>
    </changeSet>

    <changeSet id="005-book-table" author="spring-postgres-fts">
        <createTable tableName="book">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="author_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_book_author" references="author(id)"/>
            </column>
            <column name="genre_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_book_genre" references="genre(id)"/>
            </column>
            <column name="title" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="excerpt" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="published_year" type="INTEGER"/>
            <column name="source_url" type="TEXT"/>
        </createTable>
    </changeSet>

    <!--
        STORED must be written explicitly. Postgres 18 made generated columns VIRTUAL by default,
        and a virtual column cannot carry an index — `CREATE INDEX ... USING GIN (search_vector)`
        on one fails with "indexes on virtual generated columns are not supported". Omitting the
        keyword therefore breaks the index rather than the column, which is a confusing way to
        find out. Verified against real postgres:18-trixie in GeneratedColumnAndSynonymDirectionIT.

        setweight labels the lexemes A and B, and the ranking functions weight those labels
        differently by default — which is how a title match outranks an excerpt match with no
        application code involved.
    -->
    <changeSet id="006-book-search-vector-column" author="spring-postgres-fts">
        <comment>STORED, not the Postgres 18 VIRTUAL default: a virtual column cannot be indexed.</comment>
        <sql>
            ALTER TABLE book
                ADD COLUMN search_vector tsvector GENERATED ALWAYS AS (
                    setweight(to_tsvector('english', COALESCE(title, '')), 'A') ||
                    setweight(to_tsvector('english', COALESCE(excerpt, '')), 'B')
                    ) STORED;
        </sql>
    </changeSet>

    <!--
        The GIN index on search_vector earns its keep: @@ against it is an index scan at any size.

        The trigram index is honest about being partial. FUZZY's predicate is
        `book.title % :q OR author.name % :q`, and no single-table index can answer an OR that
        spans two tables, so the planner falls back to scanning both.
        Do not delete it on that basis: it does serve a title-only trigram match, which is what a
        reader adapting this to a single-column search will write. See docs/POSTGRES-FTS.md,
        "Indexes: GIN, and where each index stops helping".
    -->
    <changeSet id="007-book-indexes" author="spring-postgres-fts">
        <comment>GIN on the tsvector; trigram index on title only — FUZZY's cross-table OR cannot use it.</comment>
        <sql>
            CREATE INDEX idx_book_search_vector ON book USING GIN (search_vector);
            CREATE INDEX idx_book_title_trgm ON book USING GIN (title gin_trgm_ops);
        </sql>
    </changeSet>

    <!--
        book_synonym.syn must already exist in the server's $SHAREDIR/tsearch_data when this runs —
        bind-mounted in support/compose.yaml, copied in via withCopyFileToContainer for
        Testcontainers. CREATE TEXT SEARCH DICTIONARY fails outright if the file is missing.

        KNOWN LIMITATION (docs/POSTGRES-FTS.md, "Synonyms: one direction per pair"): the mapping is
        `WITH book_synonym, english_stem`, so only the dictionary's exact key reaches book_synonym.
        An inflected form such as "apothecaries" falls through to english_stem and never reaches
        the entry for "apothecary", so SYNONYM is not a superset of LEXICAL. The documented fix is
        a thesaurus dictionary; it is deliberately not implemented, because the synonym template is
        what makes the index-time/query-time symmetry visible, and that is the point being shown.

        EDITING THE .syn FILE LATER: each session reads the file once, the first time it uses the
        dictionary — so after an edit, sessions that already used it keep the old mapping while
        fresh ones see the new. ALTER TEXT SEARCH DICTIONARY forces existing sessions to reload,
        and any expression index built on this configuration — idx_book_synonym_vector, changeset
        009 — holds lexemes from the OLD mapping until it is REINDEXed. The index and the query
        then disagree silently, with no error and no failing test.
    -->
    <changeSet id="008-synonym-dictionary" author="spring-postgres-fts">
        <comment>Synonym dictionary + book_synonym_search config; needs book_synonym.syn on the server.</comment>
        <sql>
            CREATE
            TEXT SEARCH DICTIONARY book_synonym (
                TEMPLATE = synonym,
                SYNONYMS = book_synonym
            );

            CREATE
            TEXT SEARCH CONFIGURATION book_synonym_search (COPY = english);

            ALTER
            TEXT SEARCH CONFIGURATION book_synonym_search
                ALTER
            MAPPING FOR asciiword, asciihword, hword_asciipart, word, hword, hword_part
                    WITH book_synonym, english_stem;
        </sql>
    </changeSet>

    <changeSet id="009-book-synonym-vector-index" author="spring-postgres-fts">
        <comment>
            Functional index — not a stored column, so it must match the expression
            BookSearchExpressions builds at query time exactly, or Postgres will not use it.
        </comment>
        <sql>
            CREATE INDEX idx_book_synonym_vector ON book
                USING GIN (to_tsvector('book_synonym_search', title || ' ' || excerpt));
        </sql>
    </changeSet>

    <!--
        The seed resolves every book's author with a scalar subquery on author.name, and the entity
        model assumes one row per author. Without this constraint a duplicate name would make those
        subqueries ambiguous and split one author's books in two; with it, the attempt fails loudly
        at insert time instead.
    -->
    <changeSet id="010-author-name-unique" author="spring-postgres-fts">
        <comment>One row per author: the seed resolves authors by name with a scalar subquery.</comment>
        <addUniqueConstraint tableName="author" columnNames="name" constraintName="uq_author_name"/>
    </changeSet>

</databaseChangeLog>
